    {
      "name": "2. Каталог и слоты",
      "item": [
        {
          "name": "Услуги (публично)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{recp_url}}/services"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const x = pm.cookies.get('XSRF-TOKEN'); if (x) pm.collectionVariables.set('xsrf_token', x);",
                  "const s = pm.response.json(); pm.test('есть услуги', () => pm.expect(s.length).to.be.above(0));",
                  "pm.collectionVariables.set('service_id', s[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Врачи",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              }
            ],
            "url": "{{recp_url}}/doctors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const x = pm.cookies.get('XSRF-TOKEN'); if (x) pm.collectionVariables.set('xsrf_token', x);",
                  "const sid = Number(pm.collectionVariables.get('service_id'));",
                  "const d = pm.response.json().find(d => (d.services || []).some(s => s.id === sid));",
                  "pm.test('есть врач на услугу', () => pm.expect(d).to.exist);",
                  "pm.collectionVariables.set('doctor_id', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Свободные слоты",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              }
            ],
            "url": "{{recp_url}}/appointments/slots?doctor_id={{doctor_id}}&service_id={{service_id}}&date={{appt_date}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ближайший будний день начиная с послезавтра",
                  "const d = new Date(); d.setDate(d.getDate() + 2);",
                  "while ([0, 6].includes(d.getDay())) d.setDate(d.getDate() + 1);",
                  "pm.collectionVariables.set('appt_date', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const x = pm.cookies.get('XSRF-TOKEN'); if (x) pm.collectionVariables.set('xsrf_token', x);",
                  "const slots = pm.response.json(); pm.test('есть слоты', () => pm.expect(slots.length).to.be.above(0));",
                  "pm.collectionVariables.set('slot_start', slots[0].startAt);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Пациент записывается онлайн",
      "item": [
        {
          "name": "Онлайн-запись (PENDING)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{recp_url}}/me/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": {{doctor_id}},\n  \"serviceId\": {{service_id}},\n  \"startAt\": \"{{slot_start}}\",\n  \"comment\": \"Boli ząb\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('создано', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const a = pm.response.json();",
                  "pm.test('PENDING', () => pm.expect(a.status).to.eql('PENDING'));",
                  "pm.collectionVariables.set('appointment_id', a.id);",
                  "pm.collectionVariables.set('patient_id', a.patientId);"
                ]
              }
            }
          ]
        },
